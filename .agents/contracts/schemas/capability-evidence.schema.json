{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "model",
    "source",
    "verified_at",
    "operations",
    "parameters",
    "reference_roles",
    "max_references"
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "verified_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T.+(?:Z|[+-]\\d{2}:\\d{2})$"
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "parameters": {
      "type": "object"
    },
    "required_parameters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reference_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_references": {
      "type": "integer",
      "minimum": 0
    },
    "supports_first_frame_with_reference_images": {
      "type": "boolean"
    }
  },
  "additionalProperties": true
}
