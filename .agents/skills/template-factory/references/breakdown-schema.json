{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VideoBreakdown",
  "type": "object",
  "required": ["schema_version", "title", "shots"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "title": { "type": "string" },
    "genre": { "type": "string" },
    "visual_style": {
      "type": "object",
      "properties": {
        "grade": { "type": "string" },
        "lighting_direction": { "type": "string" },
        "lens": { "type": "string" },
        "film_look": { "type": "string" }
      }
    },
    "camera": {
      "type": "object",
      "properties": {
        "shot_sizes": { "type": "array", "items": { "type": "string" } },
        "moves": { "type": "array", "items": { "type": "string" } },
        "framing": { "type": "string" },
        "transitions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "music": { "type": ["string", "null"] },
        "sfx": { "type": "array", "items": { "type": "string" } },
        "dialogue": { "type": ["string", "null"] }
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "id", "descriptor"],
        "properties": {
          "type": { "type": "string", "enum": ["character", "location", "prop", "screen"] },
          "id": { "type": "string" },
          "tag": { "type": "string" },
          "descriptor": { "type": "string" },
          "keyframe_index": { "type": "array", "items": { "type": "integer" } },
          "in_shots": { "type": "array", "items": { "type": "integer" } }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["index", "start_s", "end_s", "duration_s"],
        "properties": {
          "index": { "type": "integer" },
          "start_s": { "type": "number" },
          "end_s": { "type": "number" },
          "duration_s": { "type": "number" },
          "composition": { "type": "string" },
          "camera": { "type": "string" },
          "action": { "type": "string" },
          "lighting": { "type": "string" },
          "audio": { "type": "string" },
          "end_state": { "type": "string" },
          "keyframe_path": { "type": "string" },
          "motion": {
            "type": "object",
            "properties": {
              "camera_motion": { "type": "string" },
              "moving_elements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "motion": { "type": "string" },
                    "direction": { "type": "string" },
                    "speed": { "type": "string" },
                    "amplitude": { "type": "string" },
                    "easing": { "type": "string" },
                    "loop_period": { "type": ["string", "null"] }
                  }
                }
              },
              "light_motion": { "type": "string" },
              "strongest_cue": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
